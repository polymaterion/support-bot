# Токен бота от @BotFather
BOT_TOKEN=

# Telegram chat_id администратора (можно узнать через @userinfobot)
ADMIN_CHAT_ID=

# Строка подключения к PostgreSQL.
# Если используете docker-compose из этого репозитория — оставьте как есть,
# сервис базы данных называется "db".
DATABASE_URL=postgresql://support_bot:support_bot@db:5432/support_bot

# Параметры для сервиса postgres в docker-compose (не нужны, если БД внешняя)
POSTGRES_USER=support_bot
POSTGRES_PASSWORD=support_bot
POSTGRES_DB=support_bot
